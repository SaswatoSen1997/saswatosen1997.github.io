{% unless page.permalink == '/' %}
  <header>
    <div id="navbar" class="navbar navbar-light">
      <div class="container">
        <a class="navbar-brand" href="{{ '/' | relative_url }}">
          {{ site.first_name }} {{ site.last_name }}
        </a>
      </div>
    </div>
  </header>
{% endunless %}
